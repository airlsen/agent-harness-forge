# ===== AgentHarness Forge 控制面环境变量（复制为 .env）=====
FORGE_DATABASE_URL=postgresql+asyncpg://forge:forge@127.0.0.1:5432/forge
FORGE_REDIS_URL=redis://127.0.0.1:6379/0

# S3 / MinIO（Session Log 归档与产物）
FORGE_S3_ENDPOINT=http://127.0.0.1:9000
FORGE_S3_BUCKET=forge-artifacts
FORGE_S3_ACCESS_KEY=
FORGE_S3_SECRET_KEY=

# Runner（执行内核适配层） endpoints，逗号分隔多个
FORGE_RUNNER_ENDPOINTS=http://127.0.0.1:9000
# Runner 回调控制面的地址（审批决策等）
FORGE_CALLBACK_BASE_URL=http://127.0.0.1:8000

# 企业模型网关（dsh 侧唯一模型出口）
FORGE_MODEL_GATEWAY_URL=http://127.0.0.1:4000

# 会话治理默认值
FORGE_SESSION_IDLE_TTL_SECONDS=1800
FORGE_APPROVAL_TIMEOUT_SECONDS=600
FORGE_EVENT_RAW_RETENTION_DAYS=180
