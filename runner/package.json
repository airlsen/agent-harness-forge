{
  "name": "@forge/runner",
  "version": "0.2.0",
  "private": true,
  "description": "AgentHarness Forge 执行内核适配层：AgentKernel 端口 + dsh 实现 + 平台插件包",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node scripts/check-workspace.mjs && node --import tsx scripts/check-business.mjs",
    "test:workspace": "node scripts/check-workspace.mjs",
    "poc": "tsx scripts/poc.mjs",
    "poc:boot-only": "tsx scripts/poc.mjs --boot-only",
    "contract": "tsx scripts/contract-check.mjs",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
