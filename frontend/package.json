{
  "name": "forge-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check src vite.config.ts",
    "check:icons": "node ../scripts/check-ui-icons.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^15.0.12",
