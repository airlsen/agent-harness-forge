{
  "name": "forge-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check src scripts vite.config.ts",
    "test": "node scripts/check-conversation-drafts.mjs && node scripts/check-turns.mjs && node scripts/check-markdown-blocks.mjs && node scripts/check-files.mjs",
    "check:icons": "node ../scripts/check-ui-icons.mjs",
    "check:colors": "node ../scripts/check-ui-colors.mjs",
    "check:antd-tokens": "node ../scripts/check-antd-tokens.mjs"
  },
  "dependencies": {
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "ant-design-vue": "^4.2.6",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.3",
    "mermaid": "^12.3.0",
    "pinia": "^2.3.0",
    "shiki": "^4.6.0",
    "vega-embed": "^7.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "^5.7.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
